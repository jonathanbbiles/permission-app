node_modules/
# ONLY the Capacitor-generated project at the repo root — it is rebuilt by
# `npx cap add ios` / `cap sync` on every Codemagic build, so Info.plist keys
# and the SPM manifest come from codemagic.yaml, not from here.
# Stays anchored: an unanchored "ios/" would match any nested ios/ directory
# (a first-party native plugin's source, say) and silently drop it from commits.
/ios/
build/
.DS_Store
*.log
package-lock.json
